10 REM ASCII ANIMATION PLAYER - TANDY 200
20 CLEAR 400:DEFINT A-Z:D=0
30 SCREEN 0,0:CLS:OPEN "FRAMES" FOR INPUT AS 1
40 IF EOF(1) THEN 130
50 LINE INPUT #1,L$:S=1
60 IF LEFT$(L$,1)="!" THEN S=2 ELSE P=0:FOR J=1 TO D:NEXT
70 FOR I=S TO LEN(L$) STEP 2
80 P=P+ASC(MID$(L$,I,1))-35:V=ASC(MID$(L$,I+1,1))-35:K=V\2
90 IF K=0 THEN 120
100 IF V AND 1 THEN PRINT @P,STRING$(K,239); ELSE PRINT @P,SPACE$(K);
110 P=P+K
120 NEXT I
125 GOTO 40
130 CLOSE 1:SCREEN 0,1:END
