10 CLS:INPUT "File";F$
20 OPEN "COM:58N1DNN" FOR INPUT AS 1
30 GOSUB 200:A=B:GOSUB 200:A=A+256*B
40 GOSUB 200:L=B:GOSUB 200:L=L+256*B
50 GOSUB 200:E=B:GOSUB 200:E=E+256*B
60 PRINT A;L;E
70 IF A<HIMEM THEN PRINT "CLEAR 256,";A;" first":END
80 FOR I=0 TO L-1:GOSUB 200:POKE A+I,B
82 IF I/20=INT(I/20) THEN PRINT I+1;
84 NEXT:PRINT:PRINT "Received all"
85 PRINT "Received all":PRINT "Saving..."
90 CLOSE 1
100 SAVEM F$,A,A+L-1,E
110 PRINT "Saved ";F$:END
200 C$=INPUT$(2,#1):X=ASC(C$)-48:IF X>9 THEN X=X-7
205 Y=ASC(MID$(C$,2,1))-48:IF Y>9 THEN Y=Y-7
207 B=X*16+Y:RETURN
