   10/EEB0 : =503CH                     LCD     EQU  503Ch              ; print char in A to screen     (VERIFY)
   11/EEB0 : =8B03H                     KYREAD  EQU  8B03h              ; poll keyboard: A=key, Z=none  (VERIFY)
   12/EEB0 : =8643H                     SD232   EQU  8643h              ; send A out RS-232             (VERIFY)
   13/EEB0 : =8519H                     RV232   EQU  8519h              ; recv RS-232: A=char, Z=none   (VERIFY)
   14/EEB0 : =191DH                     SETSER  EQU  191Dh              ; init UART, HL -> STAT string  (FILL IN)
   15/EEB0 :                            
   16/EEB0 : =27H                       WIDTH   EQU  39                 ; usable columns (40 minus 1 to avoid wrap)
